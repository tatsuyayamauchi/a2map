{
  "name": "a2map",
  "version": "1.0.0",
  "description": "Agent-to-Map (A2Map) Protocol, Controller and Differential Renderer for MapLibre GL JS",
  "keywords": [
    "a2map",
    "a2ui",
    "agentic-ai",
    "declarative-map",
    "generative-ui",
    "geospatial",
    "maplibre",
    "maplibre-gl"
  ],
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/a2map.css",
    "./dist/a2map.css": "./dist/a2map.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && node -e \"fs.copyFileSync('src/a2map.css', 'dist/a2map.css')\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.0.10",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "storybook": "^10.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "maplibre-gl": "^5.0.0 || ^6.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "zod": "^4.5.4"
  }
}
