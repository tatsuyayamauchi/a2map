{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "unicorn", "typescript", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "react/jsx-key": "error",
    "react/jsx-no-target-blank": "error",
    "no-await-in-loop": "off",
    "react/set-state-in-effect": "warn"
  },
  "ignorePatterns": [
    "dist/**",
    "dist-server/**",
    "node_modules/**",
    "storybook-static/**",
    "schema/**"
  ]
}
